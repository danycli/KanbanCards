<Window x:Class="KanbanCards.Views.UpToDateNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kanban Cards Up to Date"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Border x:Name="CardBorder" Margin="14"
            Background="#FFFFFF"
            CornerRadius="16"
            BorderThickness="1"
            BorderBrush="#1A000000"
            Padding="18,16">
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardTranslate" Y="25"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.18" ShadowDepth="6" BlurRadius="24" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Header with Success Check Icon, Title, Version Pill, and Close Button -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Checkmark Icon Container -->
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#ECFDF5" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#10B981" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title & Version Pill -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="You're Up to Date" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Border Background="#10B981" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" Text="v1.3.0" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Kanban Cards is at the latest release." FontSize="11" Foreground="#64748B" Margin="0,1,0,0"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" 
                        Click="CloseButton_Click"
                        Style="{StaticResource EditorCloseButtonStyle}"
                        Width="24" Height="24"
                        VerticalAlignment="Top"
                        ToolTip="Close"/>
            </Grid>

            <!-- ROW 1: Message Description -->
            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10" Margin="0,12,0,0">
                <TextBlock x:Name="MessageText" 
                           Text="Kanban Cards is up to date. You are using the latest version." 
                           FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" LineHeight="16"/>
            </Border>

            <!-- ROW 2: Action Button (OK) -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Button Content="OK" Click="CloseButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Background="#10B981"
                        HorizontalAlignment="Right"
                        Padding="18,6" FontSize="12"/>
            </Grid>
        </Grid>
    </Border>
</Window>
