<Window x:Class="KanbanCards.Views.EdgeStackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KanbanCards Edge Stack" Height="580" Width="320"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Focusable="False"
        Loaded="Window_Loaded">
    
    <Grid HorizontalAlignment="{Binding StackAlignment}" Width="320">
        <!-- Interactive region enclosing the note stack with hit-testable transparent background -->
        <Border x:Name="StackInteractionArea" 
                HorizontalAlignment="{Binding StackAlignment}" 
                VerticalAlignment="Center" 
                Width="320"
                Background="Transparent"
                MouseEnter="StackArea_MouseEnter" 
                MouseLeave="StackArea_MouseLeave" 
                MouseWheel="StackArea_MouseWheel">
            
            <Canvas x:Name="StackCanvas" Width="320" Height="560" HorizontalAlignment="{Binding StackAlignment}">
                <!-- Sub-canvas dedicated to notes with bounds clipping so cards exit cleanly -->
                <Canvas x:Name="NotesCanvas" Width="320" Height="500" ClipToBounds="True" />
                
                <!-- Plus button to add new notes (pinned directly below notes) -->
                <Border x:Name="AddButtonBorder" 
                        Width="280" Height="48"
                        CornerRadius="{Binding NoteCornerRadius}" 
                        BorderThickness="{Binding NoteBorderThickness}" 
                        BorderBrush="#22000000"
                        HorizontalAlignment="{Binding StackAlignment}" 
                        Cursor="Hand" Panel.ZIndex="1"
                        RenderTransformOrigin="{Binding RenderTransformOrigin}"
                        MouseEnter="AddButton_MouseEnter"
                        MouseLeave="AddButton_MouseLeave"
                        MouseLeftButtonUp="AddButton_MouseLeftButtonUp">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="AddButtonScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="AddButtonTranslate" X="0" Y="0" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6366F1" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect x:Name="AddButtonShadow" Color="#000000" Opacity="0.16" ShadowDepth="2" BlurRadius="6" Direction="270" RenderingBias="Performance"/>
                    </Border.Effect>
                    <TextBlock Text="+" FontSize="28" 
                               HorizontalAlignment="{Binding PlusHorizontalAlignment}" 
                               VerticalAlignment="Center" Foreground="White" FontWeight="Light" 
                               Margin="{Binding PlusMargin}"/>
                </Border>
            </Canvas>
        </Border>
    </Grid>
</Window>
