<Window x:Class="KanbanCards.Views.UpdateNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kanban Cards Update"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Border x:Name="CardBorder" Margin="14"
            Background="#FFFFFF"
            CornerRadius="16"
            BorderThickness="1"
            BorderBrush="#1A000000"
            Padding="18,16">
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardTranslate" Y="25"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.18" ShadowDepth="6" BlurRadius="24" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Header with App Icon, Title, Version Pill, and Close Button -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Icon Container -->
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#EEF2FF" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/AppIcon.ico" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Title & Version Pill -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Update Available" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Border Background="#6366F1" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Version}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Kanban Cards has a new release." FontSize="11" Foreground="#64748B" Margin="0,1,0,0"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" 
                        Command="{Binding DismissCommand}"
                        IsEnabled="{Binding CanInteract}"
                        Style="{StaticResource EditorCloseButtonStyle}"
                        Width="24" Height="24"
                        VerticalAlignment="Top"
                        ToolTip="Later"/>
            </Grid>

            <!-- ROW 1: Release Notes Bullet Points -->
            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="WHAT'S NEW" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Changes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="•" FontSize="12" Foreground="#6366F1" Margin="0,0,6,0" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" LineHeight="16"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ROW 2: Download Progress (Visible when downloading) -->
            <StackPanel Grid.Row="2" Margin="0,14,0,2" Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border CornerRadius="4" Background="#E2E8F0" Height="8" ClipToBounds="True">
                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding DownloadPercent}"
                                 Foreground="#6366F1" Background="Transparent" BorderThickness="0"/>
                </Border>
                <Grid Margin="0,6,0,0">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Medium" Foreground="#475569" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding DownloadPercent, StringFormat='{}{0}%'}" FontSize="11" FontWeight="SemiBold" Foreground="#6366F1" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>

            <!-- ROW 3: Error / Status text if not downloading -->
            <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="11" Foreground="#DC2626" Margin="0,8,0,0"
                       HorizontalAlignment="Center" TextWrapping="Wrap"
                       Visibility="{Binding CanInteract, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- ROW 4: Action Buttons -->
            <Grid Grid.Row="4" Margin="0,14,0,2" Visibility="{Binding CanInteract, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Release Notes Link -->
                <Button Grid.Column="0" Command="{Binding ViewReleaseNotesCommand}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="View Release Notes" FontSize="11.5" Foreground="#6366F1" TextDecorations="Underline"/>
                </Button>

                <!-- Action Buttons: Later & Update Now -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Later" Command="{Binding DismissCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,6" FontSize="12" Margin="0,0,8,0"/>
                    <Button Content="{Binding PrimaryButtonText}" Command="{Binding UpdateCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,6" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
