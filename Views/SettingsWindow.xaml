<Window x:Class="KanbanCards.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="350" Width="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,5"/>
        <CheckBox Content="Launch minimized to tray" IsChecked="{Binding LaunchMinimizedToTray}" Margin="0,5"/>
        <CheckBox Content="Show notes on desktop" IsChecked="{Binding ShowNotesOnDesktop}" Margin="0,5"/>
        <CheckBox Content="Enable animations" IsChecked="{Binding EnableAnimations}" Margin="0,5"/>
        
        <TextBlock Text="Stack position:" Margin="0,15,0,5" FontWeight="Bold"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton Content="Right" IsChecked="{Binding IsStackPositionRight}" Margin="0,0,15,0"/>
            <RadioButton Content="Left" IsChecked="{Binding IsStackPositionLeft}"/>
        </StackPanel>

        <TextBlock Text="Animation speed:" Margin="0,15,0,5" FontWeight="Bold"/>
        <Slider Minimum="0" Maximum="100" Value="{Binding AnimationSpeed}" TickFrequency="10" IsSnapToTickEnabled="True"/>
    </StackPanel>
</Window>
