<Window x:Class="KanbanCards.Views.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Note Editor" Height="400" Width="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" WindowStartupLocation="Manual">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Window.RenderTransform>
        <TranslateTransform Y="0"/>
    </Window.RenderTransform>

    <Border Style="{StaticResource ModernCardStyle}" Margin="16" Background="{Binding Color}" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Margin="16,12,16,8" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Background="#2196F3" Style="{StaticResource ColorSwatchStyle}"
                                 IsChecked="{Binding Color, Converter={StaticResource ColorConverter}, ConverterParameter='#90CAF9'}"/>
                    <RadioButton Background="#FBC02D" Style="{StaticResource ColorSwatchStyle}"
                                 IsChecked="{Binding Color, Converter={StaticResource ColorConverter}, ConverterParameter='#FFF176'}"/>
                    <RadioButton Background="#4CAF50" Style="{StaticResource ColorSwatchStyle}"
                                 IsChecked="{Binding Color, Converter={StaticResource ColorConverter}, ConverterParameter='#A5D6A7'}"/>
                    <RadioButton Background="#F44336" Style="{StaticResource ColorSwatchStyle}"
                                 IsChecked="{Binding Color, Converter={StaticResource ColorConverter}, ConverterParameter='#F48FB1'}"/>
                    <RadioButton Background="#9C27B0" Style="{StaticResource ColorSwatchStyle}"
                                 IsChecked="{Binding Color, Converter={StaticResource ColorConverter}, ConverterParameter='#CE93D8'}"/>
                    <RadioButton Background="#FF9800" Style="{StaticResource ColorSwatchStyle}"
                                 IsChecked="{Binding Color, Converter={StaticResource ColorConverter}, ConverterParameter='#FFCC80'}"/>
                </StackPanel>
                
                <Button Command="{Binding CloseCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" Cursor="Hand" Padding="8">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="14" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="16,8,16,0">
                <Border Background="#66FFFFFF" CornerRadius="8" Margin="0,0,0,0">
                    <Grid>
                        <TextBlock Text="Note Title" FontSize="20" FontWeight="Bold" Foreground="#6B7280"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,8,12,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=TitleBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=TitleBox}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="20" FontWeight="Bold"
                                 BorderThickness="0" Background="Transparent" Foreground="#111827"
                                 TextWrapping="Wrap" MaxLength="100" Padding="12,8,12,8"/>
                    </Grid>
                </Border>
            </Grid>
                     
            <Grid Grid.Row="2" Margin="16,12,16,16">
                <Border Background="#66FFFFFF" CornerRadius="8">
                    <Grid>
                        <TextBlock Text="Start typing your note here..." FontSize="15" Foreground="#6B7280"
                                   IsHitTestVisible="False" VerticalAlignment="Top" Margin="12,12,12,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=DescBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=DescBox}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="DescBox" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="15" AcceptsReturn="True"
                                 BorderThickness="0" Background="Transparent" Foreground="#374151"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12,12,12,12"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="16,0,16,16">
                <Button Command="{Binding DeleteCommand}" HorizontalAlignment="Left"
                        Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0"
                        Padding="16,8" Cursor="Hand" Style="{StaticResource SecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Delete" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding OkCommand}" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE73E;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Done" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
