<Window x:Class="KanbanCards.Views.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Note Editor" Height="660" Width="380" MinHeight="560" MinWidth="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.1"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Window.RenderTransform>
        <TranslateTransform Y="0"/>
    </Window.RenderTransform>

    <Border x:Name="CardBorder" 
            Style="{StaticResource ModernCardStyle}" 
            CornerRadius="16"
            BorderThickness="1"
            BorderBrush="#25000000"
            Margin="24" 
            Background="{Binding Color}" 
            MouseLeftButtonDown="Window_MouseLeftButtonDown"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow" Color="#000000" Opacity="0.25" ShadowDepth="6" BlurRadius="22" Direction="270" />
        </Border.Effect>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0"/>
                <TranslateTransform x:Name="CardTranslate" Y="0.0"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Top Drag Grip Handle Area -->
            <Grid Grid.Row="0" Height="16" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Border Width="36" Height="4" CornerRadius="2" Background="#26000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Color Swatches & Close Button -->
            <Grid Grid.Row="1" Margin="14,2,14,6" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton GroupName="NoteColorGroup" Background="#2196F3" Style="{StaticResource ColorSwatchStyle}"
                                 AutomationProperties.Name="Blue note color"
                                 IsChecked="{Binding Color, Converter={StaticResource ColorConverter}, ConverterParameter='#90CAF9'}"/>
                    <RadioButton GroupName="NoteColorGroup" Background="#FBC02D" Style="{StaticResource ColorSwatchStyle}"
                                 AutomationProperties.Name="Yellow note color"
                                 IsChecked="{Binding Color, Converter={StaticResource ColorConverter}, ConverterParameter='#FFF176'}"/>
                    <RadioButton GroupName="NoteColorGroup" Background="#4CAF50" Style="{StaticResource ColorSwatchStyle}"
                                 AutomationProperties.Name="Green note color"
                                 IsChecked="{Binding Color, Converter={StaticResource ColorConverter}, ConverterParameter='#A5D6A7'}"/>
                    <RadioButton GroupName="NoteColorGroup" Background="#F44336" Style="{StaticResource ColorSwatchStyle}"
                                 AutomationProperties.Name="Pink note color"
                                 IsChecked="{Binding Color, Converter={StaticResource ColorConverter}, ConverterParameter='#F48FB1'}"/>
                    <RadioButton GroupName="NoteColorGroup" Background="#9C27B0" Style="{StaticResource ColorSwatchStyle}"
                                 AutomationProperties.Name="Lavender note color"
                                 IsChecked="{Binding Color, Converter={StaticResource ColorConverter}, ConverterParameter='#CE93D8'}"/>
                    <RadioButton GroupName="NoteColorGroup" Background="#FF9800" Style="{StaticResource ColorSwatchStyle}"
                                 AutomationProperties.Name="Peach note color"
                                 IsChecked="{Binding Color, Converter={StaticResource ColorConverter}, ConverterParameter='#FFCC80'}"/>
                </StackPanel>
                
                <Button Grid.Column="1" Command="{Binding CloseCommand}" 
                        Style="{StaticResource EditorCloseButtonStyle}" 
                        VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>

            <!-- Note Title -->
            <Grid Grid.Row="2" Margin="16,6,16,0">
                <Grid>
                    <TextBlock Text="Note Title" FontSize="20" FontWeight="Bold" Foreground="#6B7280"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,8,12,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=TitleBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=TitleBox}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SoftTextBoxStyle}" Background="#A6FFFFFF" BorderBrush="#55FFFFFF"
                             FontSize="{Binding TitleFontSize}" FontWeight="Bold" AutomationProperties.Name="Note title"
                             Foreground="#111827" TextWrapping="Wrap" MaxLength="100" Padding="12,8,12,8"/>
                </Grid>
            </Grid>
                     
            <!-- Note Description -->
            <Grid Grid.Row="3" Margin="16,10,16,14">
                <Grid>
                    <TextBlock Text="Start typing your note here..." FontSize="15" Foreground="#6B7280"
                               IsHitTestVisible="False" VerticalAlignment="Top" Margin="12,12,12,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=DescBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=DescBox}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="DescBox" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SoftTextBoxStyle}" Background="#A6FFFFFF" BorderBrush="#55FFFFFF"
                             FontSize="{Binding EditorFontSize}" AcceptsReturn="True" AutomationProperties.Name="Note description"
                             Foreground="#374151" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12,12,12,12"/>
                </Grid>
            </Grid>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="4" Margin="16,0,16,10">
                <TextBlock Text="{Binding SaveError}" Foreground="#B45309" FontSize="11" TextWrapping="Wrap"
                           Margin="2,0,2,7" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SaveError}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" SelectedValue="{Binding Priority, Mode=TwoWay}" SelectedValuePath="Tag"
                              Style="{StaticResource SoftComboBoxStyle}"
                              Background="#80FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" Padding="8,5" FontSize="11"
                              AutomationProperties.Name="Note priority" ToolTip="Priority">
                        <ComboBoxItem Content="Normal priority" Tag="0"/><ComboBoxItem Content="Important" Tag="1"/><ComboBoxItem Content="Urgent" Tag="2"/>
                    </ComboBox>
                    <Border Grid.Column="1" Margin="8,0,0,0" Background="#A6FFFFFF" BorderBrush="#80FFFFFF"
                            BorderThickness="1" CornerRadius="8" Padding="3,0">
                        <DatePicker SelectedDate="{Binding DueDate, Mode=TwoWay}"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="4,2"
                                    FontSize="11" Foreground="#334155" HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                                    CalendarStyle="{Binding Color, Converter={StaticResource NoteColorToCalendarStyleConverter}}"
                                    AutomationProperties.Name="Due date" ToolTip="Choose a due date from the calendar">
                            <DatePicker.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#6366F1"/>
                                    <Setter Property="Padding" Value="3"/>
                                    <Setter Property="MinWidth" Value="26"/>
                                    <Setter Property="MinHeight" Value="24"/>
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>
                    </Border>
                </Grid>
                <CheckBox Content="Remind me on the due date" IsChecked="{Binding ReminderEnabled, Mode=TwoWay}"
                          Foreground="#475569" FontSize="11" Margin="2,0,0,8"/>
                <Grid Height="38" Margin="0,0,0,8">
                    <TextBox x:Name="TagsInput" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SoftTextBoxStyle}" Background="#A6FFFFFF" BorderBrush="#55FFFFFF"
                             VerticalContentAlignment="Center" Padding="16,5" ToolTip="Tags separated by commas"
                             AutomationProperties.Name="Note tags"/>
                    <TextBlock Text="Add tags, separated by commas" FontSize="11" Foreground="#8058473A"
                               VerticalAlignment="Center" Margin="17,0,8,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=TagsInput}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Text="CHECKLIST" FontSize="9" FontWeight="Bold" Foreground="#8058473A" Margin="2,0,0,4"/>
                <Border Background="#88FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="8" Padding="7">
                    <StackPanel>
                        <ScrollViewer MaxHeight="86" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ChecklistItems}" AutomationProperties.Name="Checklist steps">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsDone, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding StateText}" ToolTip="Mark step complete"/>
                                            <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SoftTextBoxStyle}" Background="#A6FFFFFF" BorderBrush="#55FFFFFF"
                                                     Foreground="#334155" Padding="8,5" FontSize="11" MinHeight="29"
                                                     AutomationProperties.Name="Checklist step"/>
                                            <Button Grid.Column="2" Content="×" Width="20" Height="22" Padding="0" Background="Transparent" BorderThickness="0"
                                                    Foreground="#94A3B8" AutomationProperties.Name="Remove checklist step"
                                                    Command="{Binding DataContext.RemoveChecklistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewChecklistItemText, UpdateSourceTrigger=PropertyChanged}" Padding="10,6" FontSize="11"
                                     Style="{StaticResource SoftTextBoxStyle}" Background="#D9FFFFFF" BorderBrush="#77FFFFFF"
                                     Foreground="#334155" MinHeight="34" ToolTip="Add a checklist step" AutomationProperties.Name="New checklist step"/>
                            <Button Grid.Column="1" Content="Add" Margin="6,0,0,0" Padding="9,3" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding AddChecklistItemCommand}" AutomationProperties.Name="Add checklist step"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="5" Margin="16,0,16,16" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Button Command="{Binding DeleteCommand}" HorizontalAlignment="Left"
                        Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0"
                        Padding="16,8" Cursor="Hand" Style="{StaticResource SecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Delete" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding OkCommand}" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE73E;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Done" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Resize Grip -->
            <Thumb Grid.RowSpan="6" Width="14" Height="14" Cursor="SizeNWSE" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   DragDelta="ResizeGrip_DragDelta" Margin="0,0,6,6">
                <Thumb.Template>
                    <ControlTemplate>
                        <Grid Background="Transparent">
                            <Path Data="M 10,2 L 2,10 M 10,6 L 6,10 M 10,10 L 10,10" Stroke="#80000000" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
