<Window x:Class="KanbanCards.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kanban Cards" Height="640" Width="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
        
    <Border Background="#F8FAFC" CornerRadius="18" BorderBrush="#1E000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.14" ShadowDepth="12" BlurRadius="32" Direction="270" />
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Modern Title Bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Height="56" Margin="18,4,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Branding & Note Counter -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70B;" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Kanban Cards" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" Foreground="{StaticResource PrimaryText}"/>
                    
                    <Border Background="#E2E8F0" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NoteCountText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryText}"/>
                    </Border>
                </StackPanel>
                
                <!-- Title Bar Control Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="Settings_Click" Style="{StaticResource TitleBarButtonStyle}" ToolTip="Settings">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="13"/>
                    </Button>
                    <Button Click="Minimize_Click" Style="{StaticResource TitleBarButtonStyle}" ToolTip="Minimize">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE921;" FontSize="11"/>
                    </Button>
                    <Button Click="Close_Click" Style="{StaticResource TitleBarCloseButtonStyle}" ToolTip="Close">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Search Bar & New Note Row -->
            <Grid Grid.Row="1" Margin="18,4,18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Modern Search Input Container -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Height="44">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.03" ShadowDepth="2" BlurRadius="6" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE721;" 
                                   Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        
                        <!-- Placeholder Text -->
                        <TextBlock Grid.Column="1" Text="Search notes..." Foreground="#94A3B8" FontSize="13" 
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchInput}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        
                        <TextBox x:Name="SearchInput" Grid.Column="1" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" BorderThickness="0" FontSize="13" Foreground="{StaticResource PrimaryText}" 
                                 VerticalContentAlignment="Center" CaretBrush="{StaticResource PrimaryText}"/>
                        
                        <!-- Clear Search Button -->
                        <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" 
                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Cursor="Hand" Width="32" Height="32" Margin="0,0,4,0" ToolTip="Clear search">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSearchText}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- Add Note Button -->
                <Button Grid.Column="1" Command="{Binding AddNoteCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0" Width="44" Height="44" Padding="0"
                        ToolTip="Create a new note">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE710;" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                </Button>
            </Grid>

            <!-- Notes List -->
            <ListBox Grid.Row="2" ItemsSource="{Binding FilteredNotes}" Background="Transparent" BorderThickness="0"
                     Margin="18,0,18,18" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="cardBorder" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.04" ShadowDepth="2" BlurRadius="6" Direction="270" />
                            </Border.Effect>
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.EditNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <Grid Margin="12,12,14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Left Color Indicator Bar -->
                                <Border Grid.Column="0" Width="5" CornerRadius="2.5" Background="{Binding Color}" 
                                        VerticalAlignment="Stretch" Margin="0,2,12,2"/>
                                
                                <!-- Title & Description -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Description}" Foreground="#64748B" FontSize="13" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" LineHeight="18"/>
                                </StackPanel>

                                <!-- Date & Arrow -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8,2,0,0">
                                    <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76C;" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#C7D2FE"/>
                                <Setter TargetName="cardBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#6366F1" Opacity="0.10" ShadowDepth="4" BlurRadius="12" Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
            <!-- Empty State (No Notes Yet) -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="56" Height="56" CornerRadius="28" Background="#EEF2FF" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70B;" FontSize="24" Foreground="#6366F1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No notes yet" FontSize="19" FontWeight="Bold" Foreground="{StaticResource PrimaryText}" HorizontalAlignment="Center"/>
                <TextBlock Text="Click the + button to create your first sticky card" Foreground="{StaticResource SecondaryText}" Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="13"/>
            </StackPanel>

            <!-- Search Empty State (No Matches) -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsSearchEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="56" Height="56" CornerRadius="28" Background="#F1F5F9" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE721;" FontSize="22" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No notes found" FontSize="19" FontWeight="Bold" Foreground="{StaticResource PrimaryText}" HorizontalAlignment="Center"/>
                <TextBlock Text="Try searching for another keyword" Foreground="{StaticResource SecondaryText}" Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="13"/>
            </StackPanel>

            <!-- Modal Backdrop Overlay (Dimmer) -->
            <Border x:Name="ModalDimmer" Grid.Row="0" Grid.RowSpan="3"
                    Background="#550F172A" CornerRadius="18"
                    Visibility="Collapsed" IsHitTestVisible="True"/>
        </Grid>
    </Border>
</Window>
