<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Modern Pastel Sticky Note Colors -->
    <SolidColorBrush x:Key="NoteBlue" Color="#E5F3FF" />
    <SolidColorBrush x:Key="NoteYellow" Color="#FFF9C4" />
    <SolidColorBrush x:Key="NoteGreen" Color="#E8F5E9" />
    <SolidColorBrush x:Key="NoteRed" Color="#FFEBEE" />
    <SolidColorBrush x:Key="NotePurple" Color="#F3E5F5" />
    <SolidColorBrush x:Key="NoteOrange" Color="#FFF3E0" />
    
    <!-- Accent Colors -->
    <SolidColorBrush x:Key="NoteBlueAccent" Color="#2196F3" />
    <SolidColorBrush x:Key="NoteYellowAccent" Color="#FBC02D" />
    <SolidColorBrush x:Key="NoteGreenAccent" Color="#4CAF50" />
    <SolidColorBrush x:Key="NoteRedAccent" Color="#F44336" />
    <SolidColorBrush x:Key="NotePurpleAccent" Color="#9C27B0" />
    <SolidColorBrush x:Key="NoteOrangeAccent" Color="#FF9800" />
    
    <!-- UI Colors -->
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WindowBackground" Color="#F3F4F6" />
    <SolidColorBrush x:Key="PrimaryText" Color="#1F2937" />
    <SolidColorBrush x:Key="SecondaryText" Color="#6B7280" />
    
</ResourceDictionary>
